<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_revamp_station_testMill</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/placeables/brandless/productionPointsGeneric/grainMill/store_grainMill.png</image>
        <price>288000</price>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>$data/placeables/brandless/productionPointsGeneric/grainMill/grainMill.i3d</filename>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01"/>
        </testAreas>
        <sounds>
            <place template="medImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker"/>
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/shared/sellingStationGeneric/sellingStationGenericNoCover.i3d"  linkNode="unloadTriggerLinkNode"/>
        <dynamicallyLoadedPart filename="$data/placeables/brandless/productionPointsGeneric/grainMill/grainMillProps.i3d" linkNode="props" node="0"/>
    </dynamicallyLoadedParts>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <productionPoint>
        <!-- Test-Produktionen für das Recipe-Core-Modul, wird bei Bedarf weiter ausgebaut -->
        <productions sharedThroughputCapacity="false">
            <production id="wheatFlour" name="%s %s" params="$l10n_fillType_wheat|$l10n_fillType_flour" cyclesPerHour="105" costsPerActiveHour="1">
                <inputs>
                    <input fillType="WHEAT" amount="5"/>
                </inputs>
                <outputs>
                    <output fillType="FLOUR" amount="4"/>
                </outputs>
            </production>
            <production id="barleyFlour" name="%s %s" params="$l10n_fillType_barley|$l10n_fillType_flour" cyclesPerHour="20" costsPerActiveHour="1">
                <inputs>
                    <input fillType="BARLEY" amount="30"/>
                </inputs>
                <outputs>
                    <output fillType="FLOUR" amount="22"/>
                </outputs>
            </production>
            <!-- Testfall für Mix-Gruppen. Mix-Gruppe 1 (WHEAT/BARLEY) hat Bestand, Mix-Gruppe 2
                 (OAT/SORGHUM) bekommt bewusst keinen Bestand im Testspielstand, um die rote Farbe bei
                 komplett unerfüllbarer Gruppe zu testen -->
            <production id="mixedFlour" name="%s" params="$l10n_fillType_flour" mixMode="MOST" cyclesPerHour="60" costsPerActiveHour="1">
                <inputs>
                    <input fillType="WHEAT"   amount="6" mix="1"/>
                    <input fillType="BARLEY"  amount="6" mix="1"/>
                    <input fillType="OAT"     amount="6" mix="2"/>
                    <input fillType="SORGHUM" amount="6" mix="2"/>
                    <input fillType="WATER"   amount="2"/>
                </inputs>
                <outputs>
                    <output fillType="FLOUR" amount="5"/>
                </outputs>
            </production>
            <!-- Testfall für Booster/Master-Booster. WATER ist ein optionaler Booster
                 (+50% Mehlausbeute, solange Bestand da ist). OAT und SORGHUM sind konkurrierende
                 Master-Booster (boostMode="MOST" wählt bei beiden vorhandenem Bestand den größeren
                 Faktor, SORGHUM, direkt als globalen Multiplikator auf die gesamte Produktion) -
                 für den Test bewusst Bestand bei WATER, OAT und/oder SORGHUM setzen/entziehen, um
                 den Unterschied im Rezept-Dialog und am Ausstoß zu sehen -->
            <production id="boostedFlour" name="$l10n_revamp_recipe_boostedFlour" boostMode="MOST" cyclesPerHour="60" costsPerActiveHour="1">
                <inputs>
                    <input fillType="WHEAT"   amount="6"/>
                    <input fillType="WATER"   amount="1" mix="boost"  boostFactor="1.5"/>
                    <input fillType="OAT"     amount="1" mix="master" boostFactor="2"/>
                    <input fillType="SORGHUM" amount="1" mix="master" boostFactor="3"/>
                </inputs>
                <outputs>
                    <output fillType="FLOUR" amount="5" boost="true"/>
                </outputs>
            </production>
            <!-- Testfall für Input+Output-Doppelrolle: FLOUR wird von den anderen Linien oben erzeugt,
                 hier aber selbst verbraucht - am Produktionspunkt insgesamt also gleichzeitig Input UND
                 Output, für die geplante Input+Output-Zwischen-Sektion in der Rezeptliste -->
            <production id="packagedFlour" name="%s" params="$l10n_fillType_flour" cyclesPerHour="40" costsPerActiveHour="1">
                <inputs>
                    <input fillType="FLOUR" amount="3"/>
                    <input fillType="WATER" amount="1"/>
                </inputs>
                <outputs>
                    <output fillType="STRAW" amount="2"/>
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="WHEAT"   capacity="126000"/>
            <capacity fillType="BARLEY"  capacity="144000"/>
            <capacity fillType="OAT"     capacity="60000"/>
            <capacity fillType="SORGHUM" capacity="60000"/>
            <capacity fillType="WATER"   capacity="60000"/>
            <capacity fillType="FLOUR"   capacity="60000"/>
            <capacity fillType="STRAW"   capacity="60000"/>
        </storage>

        <sellingStation supportsExtension="false">
            <!-- Testfall für Converter-Alternativen: CANOLA/SOYBEAN werden hier zu WHEAT
                 konvertiert (CANOLA 1:1, SOYBEAN 1:0.8 - bewusst ungleich, um die Ratio-Anzeige
                 auch bei einem Wert ungleich 1 zu testen), landen also nie selbst im Lager. Der
                 wheatFlour-Zutat-Eintrag (mix=0, keine Mix-Gruppe/Booster) ist damit der
                 vorgesehene Testfall für die neue Converter-Gruppen-Anzeige -->
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="WHEAT BARLEY OAT SORGHUM CANOLA SOYBEAN WATER FLOUR">
                <fillTypeConversion incomingFillType="CANOLA"  outgoingFillType="WHEAT" ratio="1"/>
                <fillTypeConversion incomingFillType="SOYBEAN" outgoingFillType="WHEAT" ratio="0.8"/>
            </unloadTrigger>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
                <spawnPlace startNode="palletAreaStart03" endNode="palletAreaEnd03"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger"/>
        <sounds>
            <idle template="grainMillIdle" linkNode="0>" pitchScale="1.0" volumeScale="0.3"/>
            <active template="grainMillWork" linkNode="0>" pitchScale="1.0" volumeScale="0.3"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>3|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>3|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>3|1|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="exactFillNode" node="0>8|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|2" />
        <i3dMapping id="unloadTriggerLinkNode" node="0>8|3" />
        <i3dMapping id="playerTrigger" node="0>9|0" />
        <i3dMapping id="playerTriggerMarker" node="0>9|1" />
        <i3dMapping id="warningStripes01" node="0>10|0" />
        <i3dMapping id="palletSpawner" node="0>11" />
        <i3dMapping id="palletAreaStart01" node="0>11|0" />
        <i3dMapping id="palletAreaEnd01" node="0>11|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>11|1" />
        <i3dMapping id="palletAreaEnd02" node="0>11|1|0" />
        <i3dMapping id="palletAreaStart03" node="0>11|2" />
        <i3dMapping id="palletAreaEnd03" node="0>11|2|0" />
        <i3dMapping id="props" node="0>12|1" />
    </i3dMappings>
</placeable>
