        <text name="revamp_setting_distributionActive"               text="Verteilen"/>
        <text name="revamp_setting_distributionActive_tooltip"       text="Schaltet das Verteilen zwischen Produktionsstätten ein oder aus. Abgeschaltet verteilt das Spiel wieder von sich aus, die eingestellten Ziele bleiben dabei erhalten."/>
        <text name="revamp_setting_distributionCostFactor"           text="Kosten fürs Verteilen"/>
        <text name="revamp_setting_distributionCostFactor_tooltip"   text="Legt fest, wie teuer das Verteilen zwischen Produktionsstätten ist. Bei 0 % wird kostenlos geliefert, bei 200 % kostet jede Lieferung doppelt so viel."/>
        <text name="revamp_setting_storageActive"                    text="Lager-Erweiterung"/>
        <text name="revamp_setting_storageActive_tooltip"            text="Schaltet den Ausgangsmodus „Einlagern“ und das gezielte Auslagern als Paletten oder Ballen ein oder aus. Abgeschaltet verhalten sich eingelagerte Waren wie „Behalten“, die Einstellung selbst bleibt erhalten."/>
        <text name="revamp_setting_buyingActive"                     text="Zutaten kaufen"/>
