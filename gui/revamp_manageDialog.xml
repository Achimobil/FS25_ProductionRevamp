<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>
    <GuiElement profile="revamp_manageDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>
        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="fs25_dialogTitle" id="dialogTitleElement" position="0px -35px"/>

            <GuiElement profile="revamp_manageListContainer" id="manageListContainer">
                <SmoothList profile="revamp_manageList" id="manageList" listSectionHeader="section" startClipperElementName="startClipperManage" endClipperElementName="endClipperManage">
                    <ListItem profile="revamp_manageListItem" name="fillTypeRow">
                        <Bitmap profile="revamp_manageListItemIcon" name="icon"/>
                        <Text profile="revamp_manageListItemName"   name="name"/>
                        <Text profile="revamp_manageListItemAmount" name="amount"/>
                        <Text profile="revamp_manageListItemMode"   name="mode"/>
                    </ListItem>
                    <!-- Zweite Zeilenform für die Produktionslinien-Ansicht: kein Fülltyp-Icon und keine Mengenspalte, dafür mehr Platz für Name und Auswahlmodi -->
                    <ListItem profile="revamp_manageListItem" name="productionRow">
                        <Text profile="revamp_manageListItemProductionName"  name="name"/>
                        <Text profile="revamp_manageListItemProductionModes" name="modes"/>
                    </ListItem>
                    <!-- Dritte Zeilenform für die Verteilen-Ansicht: statt eines Fülltyps steht hier eine Zielproduktion mit ihrem Vorschaubild, der eingestellten Obergrenze, den laufenden Lieferkosten und der Verteilstufe -->
                    <ListItem profile="revamp_manageListItem" name="distributionRow">
                        <Bitmap profile="revamp_manageListItemIcon" name="icon"/>
                        <Text profile="revamp_manageListItemTargetName" name="name"/>
                        <Text profile="revamp_manageListItemLimit"      name="limit"/>
                        <Text profile="revamp_manageListItemCosts"      name="costs"/>
                        <Text profile="revamp_manageListItemLevel"      name="level"/>
                    </ListItem>
                    <!-- Vierte Zeilenform für die Tier-Ansicht: Bild und Name der Rasse, die Bedingungen an Alter und Gesundheit und was ein Tier der Produktion einbringt -->
                    <ListItem profile="revamp_manageListItem" name="animalRow">
                        <Bitmap profile="revamp_manageListItemAnimalIcon" name="icon"/>
                        <Text profile="revamp_manageListItemAnimalName"        name="name"/>
                        <Text profile="revamp_manageListItemAnimalAge"         name="age"/>
                        <Text profile="revamp_manageListItemAnimalHealth"      name="health"/>
                        <Text profile="revamp_manageListItemAnimalResult"      name="result"/>
                    </ListItem>
                    <ListItem profile="fs25_productionDetailsListSection" name="section">
                        <Text profile="fs25_productionDetailsListSectionTitle" name="title"/>
                    </ListItem>
                </SmoothList>
                <Bitmap profile="fs25_secondaryMenuStartClipper" name="startClipperManage"/>
                <Bitmap profile="fs25_secondaryMenuStopClipper"  name="endClipperManage"/>
                <ThreePartBitmap profile="fs25_subCategoryListSliderBox" position="10px 0px">
                    <Slider profile="fs25_listSlider" dataElementId="manageList"/>
                </ThreePartBitmap>
            </GuiElement>

            <!-- Legende für das Kennzeichen an den Mengenangaben, sichtbar nur bei einer Produktionsstätte mit geteiltem Lagerplatz (siehe RevampManageDialog:updateSharedStorageHint) -->
            <Text profile="revamp_manageDialogFootnote" id="sharedStorageHint"/>
        </GuiElement>

        <!-- Untergrund der oberen Knopfreihe. Der dunkle Fuß der Dialoggrafik endet 50px über der Unterkante und lässt sich nicht vergrößern,
             ohne dieses Feld stünde die obere Reihe als einzige auf der hellen Inhaltsfläche -->
        <Bitmap profile="revamp_manageDialogButtonBoxTopBg"/>

        <!-- Obere Reihe: alles, was sich auf die markierte Zeile bezieht und deshalb mit der Ansicht wechselt.
             Jede gleichzeitig sichtbare Aktion braucht eine eigene Taste: mit dem Standardprofil buttonOK lägen alle auf Enter und nur der Mausklick würde sie noch auseinanderhalten.
             Dieselben Tasten werden von mehreren Ansichten benutzt, sichtbar ist immer nur der Satz Knöpfe der aktuellen Ansicht -->
        <BoxLayout profile="revamp_manageDialogButtonBoxTop" id="buttonsRow">
            <Button profile="revamp_buttonExtra2" text="$l10n_revamp_buyButton"               onClick="onClickBuy"             id="buyButton"/>
            <Button profile="revamp_buttonExtra3" text="$l10n_revamp_sellButton"              onClick="onClickSell"            id="sellButton"/>
            <Button profile="buttonActivate"      text="$l10n_ui_production_changeOutputMode" onClick="onClickChangeMode"      id="yesButton"/>
            <Button profile="revamp_buttonExtra2" text="$l10n_revamp_changeMixMode"           onClick="onClickChangeMixMode"   id="mixModeButton"/>
            <Button profile="revamp_buttonExtra3" text="$l10n_revamp_changeBoostMode"         onClick="onClickChangeBoostMode" id="boostModeButton"/>
            <Button profile="buttonActivate"      text="$l10n_revamp_changeDistributionLevel" onClick="onClickChangeLevel"     id="levelButton"/>
            <Button profile="revamp_buttonExtra2" text="$l10n_revamp_changeDistributionLimit" onClick="onClickChangeLimit"     id="limitButton"/>

            <!-- Platz für den Knopf eines fremden Mods, der sich auf die markierte Ware bezieht (siehe revamp_modButtons.lua).
                 Beschriftung und Sichtbarkeit kommen aus dessen Anmeldung, deshalb steht hier kein text-Attribut -->
            <Button profile="buttonMenuPrev" onClick="onClickModButtonTop" id="modButtonTop" visible="false"/>
        </BoxLayout>

        <!-- Untere Reihe: was für den ganzen Dialog gilt und in jeder Ansicht an derselben Stelle steht -->
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="revamp_buttonExtra1" text="$l10n_revamp_storageButtonSpawn"    onClick="onClickSpawn"      id="spawnButton"/>
            <Button profile="buttonOK"            text="$l10n_revamp_manageViewProductions" onClick="onClickToggleView" id="viewButton"/>

            <!-- Platz für den Knopf eines fremden Mods, der für die ganze Stätte gilt - wie in der oberen Reihe -->
            <Button profile="buttonMenuNext" onClick="onClickModButtonBottom" id="modButtonBottom" visible="false"/>

            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="noButton"/>
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <!-- Die beiden Aktionen der jeweiligen Ansicht liegen auf den Menü-Zusatztasten (Standard X und C), der Ausgangsmodus auf der Aktivieren-Taste (Leertaste)
             und der Ansichtswechsel auf der Bestätigen-Taste (Enter) - das ist dieselbe Aufteilung, die Vanilla in seinen mehrknöpfigen Dialogen nutzt
             (z.B. FieldStateDialog mit buttonActivate neben buttonOK). Ohne eigene Tasten lägen alle Knöpfe auf Enter und nur der Mausklick könnte sie noch auseinanderhalten.
             Auslagern liegt auf derselben Taste wie der gleichnamige Knopf in der Menü-Button-Leiste, sonst wechselt die Taste je nachdem, von wo aus man auslagert.
             Sie ist als einzige keiner Ansicht zugeteilt, weil Auslagern in jeder Ansicht sichtbar ist - die Aktionen der Ansichten teilen sich die übrigen drei Tasten.
             Für die beiden Knöpfe fremder Mods bleiben die Blättertasten: sie wirken in diesem Dialog nicht, weil ScreenElement:inputEvent sie nur bei einem pageSelector auswertet -->
        <Profile name="revamp_buttonExtra1" extends="buttonOK">
            <inputAction value="MENU_EXTRA_1"/>
        </Profile>
        <Profile name="revamp_buttonExtra2" extends="buttonOK">
            <inputAction value="MENU_EXTRA_2"/>
        </Profile>
        <Profile name="revamp_buttonExtra3" extends="buttonOK">
            <inputAction value="MENU_CANCEL"/>
        </Profile>
        <!-- Zweite Knopfreihe direkt über der ersten: 36px Reihenhöhe wie fs25_dialogButtonBox, dazu 8px Abstand, also 76px statt 32px über der Unterkante.
             Alle Knöpfe einer Reihe passen nur bis etwa 1100px Breite, darüber läuft die Reihe links aus dem Dialog heraus -->
        <Profile name="revamp_manageDialogButtonBoxTop" extends="fs25_dialogButtonBox">
            <position value="0px 76px"/>
            <alignmentX value="right"/>
        </Profile>
        <!-- Schließt oben an den Fuß der Dialoggrafik an und reicht bis knapp über die obere Knopfreihe.
             Erbt von baseReference und nicht von emptyPanel: emptyPanel setzt imageSliceId auf noSlice und zeichnet dann die UI-Textur selbst statt einer Fläche.
             gui.colorPreset ist die Slice, die nur die eingestellte Farbe darstellt - dasselbe Mittel benutzt Vanilla für lineSeparator.
             Geometrie von derselben Grundlage wie die Knopfreihen, nur etwas höher als eine Reihe - eigene Positionswerte trafen die Fläche nicht und liefen in den Fuß hinein.
             Aufgebaut wie fs25_dialogBgBottom, der Fuß der Dialoggrafik: derselbe Anker und dieselbe Breitenangabe.
             Das Element des Dialogs ist breiter als die Dialoggrafik darin, weil deren Kantenbilder durchsichtige Ränder haben - links etwa 4, rechts etwa 18 Einheiten.
             Die volle Breite läuft deshalb rechts sichtbar aus dem Dialog heraus. absoluteSizeOffset nimmt die Fläche auf beiden Seiten gleich weit zurück,
             die Verschiebung gleicht danach aus, dass die durchsichtigen Ränder eben nicht gleich breit sind.
             Beide Angaben sind GUI-Einheiten und hängen an der Breite des Dialogs, nicht an Bildschirmpixeln, und stimmen damit in jedem Seitenverhältnis -->
        <Profile name="revamp_manageDialogButtonBoxTopBg" extends="baseReference" with="anchorBottomStretchingX">
            <size value="100% 44px"/>
            <position value="-8px 72px"/>
            <absoluteSizeOffset value="27px 0px"/>
            <imageSliceId value="gui.colorPreset"/>
            <imageColor value="$preset_fs25_colorMainDark"/>
        </Profile>
        <Profile name="revamp_manageDialogBg" extends="fs25_dialogBg">
            <size value="1100px 744px"/>
        </Profile>
        <Profile name="revamp_manageListContainer" extends="emptyPanel" with="anchorTopLeft">
            <size value="1020px 480px"/>
            <position value="20px -100px"/>
        </Profile>
        <Profile name="revamp_manageList" extends="fs25_subCategoryList" with="anchorTopLeft">
            <size value="1020px 480px"/>
            <listItemSpacing value="8px"/>
            <listSectionSpacing value="16px"/>
        </Profile>
        <Profile name="revamp_manageListItem" extends="baseReference" with="anchorTopStretchingX alternating">
            <height value="50px"/>
            <imageColor value="$preset_fs25_colorGrey"/>
            <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
            <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
        </Profile>
        <Profile name="revamp_manageListItemIcon" extends="baseReference" with="anchorMiddleLeft">
            <size value="30px 30px"/>
            <position value="10px 0px"/>
            <imageSliceId value="noSlice"/>
        </Profile>
        <Profile name="revamp_manageListItemName" extends="fs25_textDarkHighlight" with="anchorMiddleLeft">
            <position value="55px 0px"/>
            <width value="300px"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="revamp_manageListItemAmount" extends="fs25_textDarkHighlight" with="anchorMiddleLeft">
            <position value="380px 0px"/>
            <width value="320px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="revamp_manageListItemMode" extends="fs25_textDarkHighlight" with="anchorMiddleLeft">
            <position value="730px 0px"/>
            <width value="260px"/>
            <textColor value="$preset_fs25_colorMainHighlight"/>
        </Profile>
        <Profile name="revamp_manageListItemProductionName" extends="revamp_manageListItemName">
            <position value="20px 0px"/>
            <width value="420px"/>
        </Profile>
        <Profile name="revamp_manageListItemProductionModes" extends="revamp_manageListItemMode">
            <position value="450px 0px"/>
            <width value="540px"/>
        </Profile>
        <!-- Spalten der Verteilen-Ansicht. Der Name ist etwas schmaler als in der Waren-Ansicht, weil dahinter drei statt zwei Angaben stehen;
             Obergrenze und Kosten rechtsbündig, damit die Zahlen untereinander vergleichbar bleiben -->
        <Profile name="revamp_manageListItemTargetName" extends="revamp_manageListItemName">
            <width value="320px"/>
        </Profile>
        <Profile name="revamp_manageListItemLimit" extends="fs25_textDarkHighlight" with="anchorMiddleLeft">
            <position value="390px 0px"/>
            <width value="200px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="revamp_manageListItemCosts" extends="fs25_textDarkHighlight" with="anchorMiddleLeft">
            <position value="610px 0px"/>
            <width value="190px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="revamp_manageListItemLevel" extends="revamp_manageListItemMode">
            <position value="830px 0px"/>
            <width value="180px"/>
        </Profile>
        <!-- Spalten der Tier-Ansicht. Das Bild der Rasse ist breiter als ein Fülltyp-Symbol, weil es ein Foto und kein Piktogramm ist;
             Bedingungen und Liefermenge stehen rechtsbündig, damit die Zahlen untereinander vergleichbar bleiben -->
        <Profile name="revamp_manageListItemAnimalIcon" extends="revamp_manageListItemIcon">
            <size value="60px 40px"/>
        </Profile>
        <Profile name="revamp_manageListItemAnimalName" extends="revamp_manageListItemName">
            <position value="85px 0px"/>
            <width value="280px"/>
        </Profile>
        <Profile name="revamp_manageListItemAnimalAge" extends="fs25_textDarkHighlight" with="anchorMiddleLeft">
            <position value="375px 0px"/>
            <width value="200px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="revamp_manageListItemAnimalHealth" extends="fs25_textDarkHighlight" with="anchorMiddleLeft">
            <position value="595px 0px"/>
            <width value="140px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="revamp_manageListItemAnimalResult" extends="revamp_manageListItemMode">
            <position value="755px 0px"/>
            <width value="255px"/>
            <textAlignment value="right"/>
        </Profile>
        <!-- Fußnote unter der Liste: grau und kleiner als die Zeilen selbst, damit sie als Erläuterung und nicht als weitere Zeile gelesen wird.
             Die Liste endet 580px unter der oberen Kante des Inhaltsbereichs, die obere der beiden Knopfreihen beginnt 112px über der unteren Kante des Dialogs - dazwischen liegt genau diese eine Zeile -->
        <Profile name="revamp_manageDialogFootnote" extends="fs25_textGrey" with="anchorTopLeft">
            <position value="20px -588px"/>
            <width value="1020px"/>
            <textSize value="14px"/>
        </Profile>
    </GUIProfiles>
</GUI>
